{
  "rewrites": [
    { "source": "/img/fav.webp", "destination": "/img/favicon/fav.webp" },
    { "source": "/16school/fav.webp", "destination": "/16school/favicon/fav.webp" },
    { "source": "/korea/16school/fav.webp", "destination": "/korea/16school/favicon/fav.webp" },
    { "source": "/favicon/:path*", "destination": "/img/favicon/:path*" },
    { "source": "/terms", "destination": "/legal/terms.html" },
    { "source": "/privacy", "destination": "/legal/privacy.html" },
    { "source": "/tokusho", "destination": "/legal/tokusho.html" },
    { "source": "/company", "destination": "/legal/company.html" },
    { "source": "/terms.html", "destination": "/legal/terms.html" },
    { "source": "/privacy.html", "destination": "/legal/privacy.html" },
    { "source": "/tokusho.html", "destination": "/legal/tokusho.html" },
    { "source": "/company.html", "destination": "/legal/company.html" },
    { "source": "/mobby_pink.webp", "destination": "/img/mobby/mobby_pink.webp" },
    { "source": "/mobby_purple.webp", "destination": "/img/mobby/mobby_purple.webp" },
    { "source": "/mobby_blue.webp", "destination": "/img/mobby/mobby_blue.webp" },
    { "source": "/mobby_orange.webp", "destination": "/img/mobby/mobby_orange.webp" },
    { "source": "/mobby_pink2.webp", "destination": "/img/mobby/mobby_pink2.webp" },
    { "source": "/mobby_yellow.webp", "destination": "/img/mobby/mobby_yellow.webp" },
    { "source": "/mobby_purple2.webp", "destination": "/img/mobby/mobby_purple2.webp" },
    { "source": "/mobby_blue2.webp", "destination": "/img/mobby/mobby_blue2.webp" },
    { "source": "/16school/((?!api|.*\\..*).*)", "destination": "/16school/index.html" },
    { "source": "/((?!api|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/gacha-line-delivery-cron",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
